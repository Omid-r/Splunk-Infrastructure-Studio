# ---- Required secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ----
# HMAC key for session signing (64 hex chars)
SESSION_SECRET="CHANGE_ME_64_HEX_CHARS"

# Key for encrypting credential references at rest (64 hex chars)
SECRET_ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS"

# ---- Server ----
# UI/API port. Suggested default: 8443
APP_PORT="8443"
APP_HOST="127.0.0.1"

# ---- TLS (production / real networks) ----
# Development runs plain HTTP on localhost by default.
# For HTTPS use: npm run dev:https (Next.js self-signed, browser warning expected)
# or terminate TLS with a reverse proxy (recommended for production).
# TLS_CERT_PATH=""
# TLS_KEY_PATH=""

# ---- Retention / audit ----
# Days to keep audit events and job events (default 90)
AUDIT_RETENTION_DAYS="90"

# ---- Scan safety ----
# Hard cap of hosts per scan job (default 1024). Larger scopes are rejected.
SCAN_MAX_HOSTS="1024"
